# Copy to .env and adjust. .env is gitignored; this template is committed.
#
# API base URL sent by the browser.
#
# Leave it as the relative default. The browser then treats the API as same-origin, which is what
# Vite's dev proxy provides locally and what the API provides once it hosts the built SPA.
#
# Set an absolute origin only when the SPA and the API are hosted on different origins. That
# deployment needs CORS enabled on the API, which is not configured today.
# Leave empty. The generated client already contains full paths such as /api/v1/programs, so this
# value is an origin, not a path prefix. Setting it to /api would produce /api/api/v1/programs.
VITE_API_BASE_URL=

# Dev-only. Vite proxies /api and /health to this target. Ignored in a production build.
VITE_API_TARGET=http://localhost:5080
